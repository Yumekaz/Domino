# Copy to .env for local configuration; never commit real credentials.
# Use the same URL-safe database password in .env.postgres and DATABASE_URL.
DATABASE_URL=postgresql://domino:replace-with-a-url-safe-password@postgres:5432/domino
# Required when the API binds beyond loopback, including in containers.
DOMINO_API_TOKEN=replace-with-a-long-random-token
DOMINO_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Optional, server-side only. Public unauthenticated imports have lower rate limits.
DOMINO_GITHUB_TOKEN=
DOMINO_OPENAI_API_KEY=
DOMINO_LLM_MODEL=gpt-6-luna
# Optional local symbol-source enrichment. Empty keeps the baseline engine.
DOMINO_CODE_INTELLIGENCE=
# Absolute path to the separately installed, pinned CBM 0.12.1 executable.
DOMINO_CBM_BINARY=
# Dedicated private server-side cache outside imported repositories. Defaults to ~/.domino-cbm.
# On Windows, prefer a direct child of your profile; shared temp/Desktop ancestors may fail CBM ACL checks.
DOMINO_CBM_CACHE_DIR=
# Optional native local PostgreSQL startup. setup:postgres prints absolute paths.
# Keep its data and binaries in .domino, outside npm-managed node_modules.
DOMINO_PG_BIN_DIR=
DOMINO_PG_DATA_DIR=
# Optional read-only observation of completed pr-impact.yml runs for indexed public repositories.
# Reports are recomputed locally at the verified PR head; no public webhook is opened.
DOMINO_ACTIONS_SYNC=0
