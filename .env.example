# Copy to .env for local configuration; never commit real credentials.
# Compose requires a URL-safe database password in both values below.
POSTGRES_PASSWORD=replace-with-a-url-safe-password
DATABASE_URL=postgresql://domino:replace-with-a-url-safe-password@postgres:5432/domino
# Required when the API binds beyond loopback, including in containers.
DOMINO_API_TOKEN=replace-with-a-long-random-token
DOMINO_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Optional, server-side only. Public unauthenticated imports have lower rate limits.
DOMINO_GITHUB_TOKEN=
DOMINO_OPENAI_API_KEY=
DOMINO_LLM_MODEL=gpt-4o-mini
