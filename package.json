{
  "name": "domino-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/api",
    "apps/worker",
    "packages/contracts",
    "packages/code-intelligence",
    "packages/database",
    "packages/core/evidence",
    "packages/core/history",
    "packages/core/impact",
    "packages/core/knowledge-risk",
    "packages/dependency-adapter",
    "packages/git-adapter",
    "packages/github-adapter",
    "packages/llm-adapter",
    "packages/retrieval"
  ],
  "scripts": {
    "demo": "node --use-system-ca --env-file-if-exists=.env --import tsx tools/local-demo.mjs",
    "demo:doctor": "node --use-system-ca --env-file-if-exists=.env --import tsx tools/local-demo.mjs doctor",
    "demo:stop": "node --use-system-ca --env-file-if-exists=.env --import tsx tools/local-demo.mjs stop",
    "setup:postgres": "node --use-system-ca tools/setup-local-postgres.mjs",
    "setup:cbm": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-cbm.ps1",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts",
    "start:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "start:worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/database/src/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.backend.json && tsc --noEmit -p tsconfig.history.integration.json && tsc --noEmit -p tsconfig.impact.integration.json",
    "typecheck:history": "tsc --noEmit -p tsconfig.history.integration.json",
    "typecheck:impact": "tsc --noEmit -p tsconfig.impact.integration.json",
    "test": "vitest run && npm run test:history && npm run test:impact",
    "test:history": "node --test packages/core/history/test/*.test.ts packages/core/evidence/test/*.test.ts packages/core/knowledge-risk/test/*.test.ts packages/git-adapter/test/*.test.ts packages/github-adapter/test/*.test.ts packages/llm-adapter/test/*.test.ts packages/retrieval/test/*.test.ts apps/worker/src/handlers/history/test/*.test.ts",
    "test:impact": "node --test packages/core/impact/test/*.test.ts packages/dependency-adapter/test/*.test.ts apps/worker/src/handlers/analysis/test/*.test.ts integrations/github-action/test/*.test.ts",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "axe-core": "4.14.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
