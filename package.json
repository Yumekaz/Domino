{
  "name": "domino-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/api",
    "apps/worker",
    "packages/contracts",
    "packages/database"
  ],
  "scripts": {
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.backend.json",
    "test": "vitest run",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
